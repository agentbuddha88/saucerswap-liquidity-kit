# Hedera JSON-RPC endpoint (testnet default, change for mainnet)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Optional: override LiquidityHelper constructor (defaults from env/addresses.testnet.json)
SAUCERSWAP_V1_ROUTER=0x0000000000000000000000000000000000004b40
SAUCERSWAP_WHBAR=0x0000000000000000000000000000000000003ad2

# Don't fill manually. Run npm run account:generate or npm run account:import first.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=
