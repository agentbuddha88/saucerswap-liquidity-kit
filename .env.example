# Root env example — copy to packages/hardhat/.env and packages/nextjs/.env.local as needed.
# Never commit real private keys or WalletConnect secrets.

# --- Hardhat (packages/hardhat/.env) ---
HEDERA_RPC_URL=https://testnet.hashio.io/api
# Optional overrides for LiquidityHelper deploy (defaults come from env/addresses.testnet.json)
SAUCERSWAP_V1_ROUTER=0x0000000000000000000000000000000000004b40
SAUCERSWAP_WHBAR=0x0000000000000000000000000000000000003ad2
# Populated by: npm run hardhat:account:generate  OR  npm run hardhat:account:import
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# --- Next.js (packages/nextjs/.env.local) ---
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=https://mainnet.hashio.io/api
# Optional: your own WalletConnect Cloud project id
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
